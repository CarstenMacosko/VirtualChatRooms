{
  "name": "@vcr/realm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Colyseus realtime server: presence, session state, groups, seats, games.",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../../packages/protocol/src --import tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "0.18.21",
    "@colyseus/schema": "5.0.42",
    "@colyseus/ws-transport": "0.18.4",
    "@vcr/protocol": "workspace:*",
    "jose": "6.2.13",
    "livekit-server-sdk": "2.19.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
