{
  "name": "@vcr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "REST API: auth, contacts, rooms, avatars, sessions, media tokens.",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../../packages/protocol/src --import tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@fastify/cors": "11.3.1",
    "@vcr/protocol": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
