# Copied to .env automatically by `pnpm dev` if .env doesn't exist.
# Every value here is for local development only.

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORT=3001
# Leave empty to use embedded PGlite (no Docker needed). With `pnpm infra:up`, use:
# DATABASE_URL=postgres://vcr:vcr@localhost:5432/vcr
DATABASE_URL=
WEB_ORIGIN=http://localhost:5173

# Shared by the API (signs) and the realm server (verifies). At least 32 characters.
SESSION_TOKEN_SECRET=dev-only-session-secret-change-me-0123456789

# --- Realm (apps/realm) ---
REALM_PORT=2567
# Where the realm reports ended sessions.
API_URL=http://127.0.0.1:3001

# --- LiveKit (used by the realm, which mints media tokens and enforces host controls) ---
# Matches `livekit-server --dev`, which `pnpm dev` starts when it's installed (tools/livekit).
# Leave LIVEKIT_URL empty to run without voice and video.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Web (apps/web; Vite only exposes VITE_* variables to the browser) ---
VITE_REALM_URL=ws://localhost:2567

# --- Object storage (Phase 4; SeaweedFS from docker-compose) ---
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=vcr-dev

# --- Room capture (Phase 4) ---
# Optional. Without it you can still import existing .ply / .spz scans.
KIRI_API_KEY=
