# Copied to .env automatically by `pnpm dev` if .env doesn't exist.
# Every value here is for local development only.

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORT=3001
# Leave empty to use embedded PGlite (no Docker needed). With `pnpm infra:up`, use:
# DATABASE_URL=postgres://vcr:vcr@localhost:5432/vcr
DATABASE_URL=
WEB_ORIGIN=http://localhost:5173

# Shared by the API (signs) and the realm server (verifies). At least 32 characters.
SESSION_TOKEN_SECRET=dev-only-session-secret-change-me-0123456789

# Real accounts (Clerk: email and Google sign-in). Create an application at
# https://dashboard.clerk.com, then copy its keys here. Leave both empty to use the
# development sign-in instead (it's always off in production).
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
# Optional: Clerk's "JWT public key" (PEM), to verify sign-ins without fetching keys.
CLERK_JWT_KEY=

# Web Push for calls while the app is closed. `pnpm dev` generates a key pair into .env when
# these are empty. VAPID_SUBJECT is a contact address push services can reach you at.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@localhost

# --- Realm (apps/realm) ---
REALM_PORT=2567
# Where the realm reports ended sessions.
API_URL=http://127.0.0.1:3001

# --- LiveKit (used by the realm, which mints media tokens and enforces host controls) ---
# Matches `livekit-server --dev`, which `pnpm dev` starts when it's installed (tools/livekit).
# For calls with people outside your network (`pnpm share`), use a LiveKit Cloud project
# instead: its wss://….livekit.cloud URL and an API key and secret from its Settings → Keys.
# Leave LIVEKIT_URL empty to run without voice and video.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- Web (apps/web; Vite only exposes VITE_* variables to the browser) ---
# Optional: where the browser finds the realm server. Empty means the page's own origin at
# /realm, which the dev server (and `pnpm share`) forward to the realm.
VITE_REALM_URL=

# --- Object storage (Phase 4: room scans) ---
# "fs" (the default) keeps uploads under apps/api/.data/storage and serves them through signed
# API routes. "s3" uses an S3-compatible bucket: SeaweedFS from docker-compose, or Cloudflare R2
# (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto). The bucket's CORS
# must allow GET and PUT from WEB_ORIGIN and expose the ETag header (browsers upload directly).
STORAGE_DRIVER=fs
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=vcr-dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# SeaweedFS and MinIO need path-style URLs; set to 0 for virtual-hosted style.
S3_FORCE_PATH_STYLE=1

# --- Room capture (Phase 4) ---
# Optional: turns recorded videos into rooms with the KIRI Engine API. Without it you can still
# import existing .ply / .spz scans from Scaniverse, Polycam or the KIRI app.
KIRI_API_KEY=
